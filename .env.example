# InferenceOS Gateway Configuration
INFERENCEOS_HOST=0.0.0.0
INFERENCEOS_PORT=8080
INFERENCEOS_ADMIN_KEY=admin-secret-key-123
INFERENCEOS_ALLOW_LOCAL_BACKENDS=true

# Queue & Timeout Invariants
INFERENCEOS_MAX_QUEUE_DEPTH=500
INFERENCEOS_QUEUE_TIMEOUT_MS=15000
INFERENCEOS_UPSTREAM_TIMEOUT_MS=60000
INFERENCEOS_HEALTH_CHECK_INTERVAL_SECS=5

# Database Persistence (Optional)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inferenceos
